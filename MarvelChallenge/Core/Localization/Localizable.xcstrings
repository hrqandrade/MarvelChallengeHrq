    "demo.blackPanther.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "King of Wakanda, protector of his people and bearer of the Black Panther legacy." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Rei de Wakanda, protetor de seu povo e herdeiro do legado do Pantera Negra." } } } },
    "demo.captainMarvel.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A powerful cosmic hero who protects Earth and the universe from intergalactic threats." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Uma poderosa heroína cósmica que protege a Terra e o universo de ameaças intergalácticas." } } } },
