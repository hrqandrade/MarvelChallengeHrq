    "demo.ironMan.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Inventor Tony Stark uses his technology and courage to defend a better future." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O inventor Tony Stark usa tecnologia e coragem para defender um futuro melhor." } } } },
    "demo.spiderMan.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A friendly neighborhood hero who balances everyday life with extraordinary responsibility." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O amigo da vizinhança que equilibra a vida cotidiana com uma responsabilidade extraordinária." } } } },
    "demo.storm.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A mutant leader with the power to command the weather and inspire heroes around the world." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Uma líder mutante capaz de controlar o clima e inspirar heróis ao redor do mundo." } } } },
